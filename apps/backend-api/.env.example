PORT=3000
NODE_ENV=development
DATABASE_URL=postgresql://sbz_user:sbz_dev_password@localhost:5432/student_kwacha
JWT_SECRET=dev-jwt-secret-key-change-in-production
JWT_REFRESH_SECRET=dev-refresh-secret-key-change-in-production
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
ML_SERVICE_URL=http://localhost:5001
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ── Budget funding (PayPal) ──
# Leave PAYPAL_CLIENT_ID empty to run in clearly-labelled SIMULATED mode:
# charges succeed instantly and no real money moves. With credentials set,
# the PayPal REST API (sandbox by default) is used.
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# PayPal does not support ZMW — set to USD (or EUR, GBP, etc.) when
# credentials above are configured.
PAYPAL_CURRENCY=ZMW

# How often the funding scheduler checks for due budgets (minutes)
FUNDING_CHECK_INTERVAL_MINUTES=60

# ── Payments ──
# All money movement goes through PayPal card processing (see PayPal section
# above). No mobile money / card top-ups: the wallet only holds budget funds
# released from card authorization holds.
APP_BASE_URL=http://localhost:3000
